# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Nodemailer / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="sistemas@dimer.com.mx"
SMTP_PASS="tu_contraseña_de_aplicacion"
SMTP_FROM="Dimer Notificaciones <NO-REPLY@DIMER.COM.MX>"
SMTP_REPLY_TO="sistemas@dimer.com.mx"

# Dirección de Finanzas para notificaciones de solicitudes aprobadas
FINANZAS_EMAIL="finanzas@dimer.com.mx"

# NextAuth / Auth Configuration (para despliegues Next.js / Auth.js)
NEXTAUTH_SECRET="tu_secreto_super_seguro_jwt"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
DATABASE_URL="postgresql://postgres:password@localhost:5432/viaticos_db"

