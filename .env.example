# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL where the app is hosted.
APP_URL="MY_APP_URL"

# Canonical SMTP configuration for Google Workspace.
# Use ONLY these SMTP_* variables in the runtime environments.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="sistemas@dimer.com.mx"
SMTP_PASS="tu_contraseña_de_aplicacion_de_16_caracteres"
SMTP_FROM="Dimer Notificaciones <sistemas@dimer.com.mx>"

# Optional reply-to address.
SMTP_REPLY_TO="sistemas@dimer.com.mx"

# Address for approved-request notifications.
FINANZAS_EMAIL="finanzas@dimer.com.mx"

# Session/authentication configuration.
JWT_SECRET="tu_secreto_super_seguro_jwt"
NEXTAUTH_SECRET="tu_secreto_super_seguro_jwt"
NEXTAUTH_URL="http://localhost:3000"
