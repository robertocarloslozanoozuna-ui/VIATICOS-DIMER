{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**/*.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/approval-response/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|approval-response/).*)",
      "destination": "/index.html"
    }
  ]
}
